{
  "name": "laserline-workspace",
  "private": true,
  "description": "npm workspace of the laserline packages and the web demo",
  "workspaces": [
    "packages/laserline",
    "packages/laserline-angular"
  ],
  "scripts": {
    "build:wasm": "scripts/build-wasm.sh",
    "build:laserline": "npm run build -w @javerik/laserline",
    "build:angular": "ng build laserline-angular",
    "build:web": "ng build laserline-web",
    "build": "npm run build:laserline && npm run build:angular && npm run build:web",
    "start": "ng serve laserline-web",
    "test": "npm test -w @javerik/laserline && ng test laserline-angular --no-watch",
    "ng": "ng"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
